@model PlaylistApp.Models.DTOs.CreatePlaylistDto

<div style="background-color: #0f172a; min-height: 100vh; width: 100vw; position: relative; left: 50%; right: 50%; margin-left: -50vw; margin-right: -50vw; margin-top: -1.5rem; margin-bottom: -1.5rem;" class="py-5">
    <div class="container" style="max-width: 700px;">
        <div class="card border-0 shadow-lg" style="background-color: #1e293b; border-radius: 16px;">

            <div class="card-header border-bottom border-secondary border-opacity-25 bg-transparent p-4 d-flex justify-content-between align-items-center">
                <div>
                    <h4 class="fw-bold text-white mb-0" style="letter-spacing: -0.5px;">Create New Playlist</h4>
                    <p class="text-secondary small mb-0">Add tracks and organize your mix</p>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary text-light btn-sm px-3" style="border-radius: 8px;">Cancel</a>
            </div>

            <div class="card-body p-4 p-sm-5">
                <form method="post">

                    <div class="mb-4">
                        <label asp-for="Title" class="form-label text-secondary small fw-semibold">Playlist Title</label>
                        <input asp-for="Title" class="form-control border-0 py-2 px-3" style="background-color: #334155; color: #f8fafc; border-radius: 8px;" placeholder="e.g. OPM Chill Hits" />
                        <span asp-validation-for="Title" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <h5 class="fw-semibold text-white mt-4 mb-3" style="letter-spacing: -0.3px;">Track List (YouTube Links)</h5>

                    @for (int i = 0; i < Model.Videos.Count; i++)
                    {
                        <div class="card mb-3 border-0" style="background-color: #0f172a; border-radius: 12px;">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="badge bg-dark bg-opacity-50 text-indigo border border-secondary border-opacity-25 px-3 py-2" style="border-radius: 8px; color: #818cf8;">
                                        Track #@(i + 1)
                                    </span>
                                    @if (Model.Videos.Count > 1)
                                    {
                                        <button type="submit"
                                                asp-action="RemoveVideoRow"
                                                asp-route-index="@i"
                                                formnovalidate
                                                class="btn btn-outline-danger btn-sm px-2 py-1"
                                                style="border-radius: 6px; font-size: 0.8rem;">
                                            Remove
                                        </button>
                                    }
                                </div>
                                <div class="mb-2">
                                    <input name="Videos[@i].YouTubeUrl"
                                           value="@Model.Videos[i].YouTubeUrl"
                                           class="form-control border-0 py-2 px-3"
                                           style="background-color: #334155; color: #f8fafc; border-radius: 8px;"
                                           placeholder="YouTube URL" />
                                </div>
                                <div>
                                    <input name="Videos[@i].TrackNote"
                                           value="@Model.Videos[i].TrackNote"
                                           class="form-control border-0 py-2 px-3"
                                           style="background-color: #334155; color: #f8fafc; border-radius: 8px;"
                                           placeholder="Track Note" />
                                </div>
                            </div>
                        </div>
                    }

                    <div class="mb-4">
                        <button type="submit" asp-action="AddVideoRow" formnovalidate class="btn w-100 fw-semibold text-white py-2" style="background-color: rgba(99, 102, 241, 0.15); border: 1px dashed #6366f1; color: #818cf8; border-radius: 8px;">
                            + Add Another Track
                        </button>
                    </div>

                    <hr class="border-secondary border-opacity-25 my-4" />

                    <div class="d-grid">
                        <button type="submit" asp-action="Save" class="btn text-white fw-semibold py-2" style="background-color: #6366f1; border-radius: 8px; transition: all 0.2s ease;">
                            Save Complete Playlist
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>