@model List<PlaylistApp.Models.Entities.Playlist>

<div class="container py-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 pb-4 mb-4 border-bottom border-secondary border-opacity-25">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-indigo bg-opacity-10 text-indigo border border-indigo border-opacity-25 px-2 py-1 small" style="color: #818cf8; background-color: rgba(99, 102, 241, 0.1); box-shadow: 0 0 12px rgba(99, 102, 241, 0.2);">Dashboard</span>
                <span class="text-secondary small">• Welcome back, <strong class="text-white">@ViewBag.Username</strong></span>
            </div>
            <h2 class="fw-bold text-white mb-0" style="letter-spacing: -0.5px;">My Playlists</h2>
        </div>

        <div class="d-flex align-items-center gap-3">
            <a asp-action="Create"
               class="btn text-white fw-semibold px-4 py-2 d-flex align-items-center gap-2"
               style="background-color: #6366f1; border-radius: 10px; transition: all 0.25s ease; box-shadow: 0 0 15px rgba(99, 102, 241, 0.4);">
                <i class="bi bi-plus-lg"></i> Create Playlist
            </a>

            <a asp-controller="Auth"
               asp-action="Logout"
               class="btn btn-outline-danger btn-sm px-3 py-2 fw-semibold"
               style="border-radius: 10px;">
                Logout
            </a>
        </div>
    </div>

    <div class="row g-4">
        @foreach (var playlist in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 border position-relative playlist-card"
                     style="background-color: #1e293b;
                                border-color: rgba(99, 102, 241, 0.25) !important;
                                border-radius: 16px;
                                box-shadow: 0 0 20px rgba(99, 102, 241, 0.15), inset 0 0 15px rgba(255, 255, 255, 0.02);
                                transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
                                overflow: hidden;">

                    <div class="position-absolute top-0 start-50 translate-middle-x pointer-events-none"
                         style="width: 200px; height: 80px; background: radial-gradient(circle, rgba(99, 102, 241, 0.2) 0%, rgba(30, 41, 59, 0) 70%); border-radius: 50%; opacity: 0.7;"></div>

                    <div class="card-body p-4 d-flex flex-column justify-content-between position-relative" style="z-index: 1;">
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-3">

                                <div class="p-2 rounded-3 d-flex align-items-center justify-content-center"
                                     style="background-color: rgba(51, 65, 85, 0.8); color: #818cf8; border: 1px solid rgba(129, 140, 248, 0.3); box-shadow: 0 0 12px rgba(99, 102, 241, 0.3);">
                                    <i class="bi bi-music-note-beamer fs-5"></i>
                                </div>
                                <span class="badge bg-dark bg-opacity-50 border border-indigo border-opacity-25 px-3 py-2"
                                      style="border-radius: 20px; color: #818cf8; box-shadow: 0 0 10px rgba(99, 102, 241, 0.15);">
                                    @playlist.Videos.Count Tracks
                                </span>
                            </div>

                            <h5 class="card-title fw-bold text-white mb-2" style="letter-spacing: -0.3px;">
                                @playlist.Title
                            </h5>
                        </div>

                        <div class="pt-3 mt-3 border-top border-secondary border-opacity-25 d-flex justify-content-between align-items-center">
                            <span class="text-secondary small">
                                Creator: <strong class="text-light">@playlist.CreatorName</strong>
                            </span>

                            <span class="text-indigo small fw-semibold d-flex align-items-center gap-1"
                                  style="color: #818cf8;">
                                View Mix <i class="bi bi-arrow-right ms-1"></i>
                            </span>
                        </div>
                    </div>

                </div>
            </div>
        }
    </div>
</div>

<style>
    /* Card hover state for dynamic interactive glow */
    .playlist-card:hover {
        transform: translateY(-4px);
        border-color: rgba(99, 102, 241, 0.6) !important;
        box-shadow: 0 0 25px rgba(99, 102, 241, 0.35), inset 0 0 20px rgba(99, 102, 241, 0.05) !important;
    }
</style>