@model List<PlaylistApp.Models.Entities.Playlist>

<div class="container mt-4">

    <div class="d-flex justify-content-between mb-3">
        <h2>My Playlists</h2>

        <div>
            <span class="me-3">
                Welcome,
                <strong>@ViewBag.Username</strong>
            </span>

            <a asp-controller="Auth"
               asp-action="Logout"
               class="btn btn-danger btn-sm">
                Logout
            </a>
        </div>
    </div>

    <a asp-action="Create"
       class="btn btn-primary mb-3">
        Create Playlist
    </a>

    <table class="table table-bordered">

        <thead>

            <tr>

                <th>Title</th>

                <th>Creator</th>

                <th>Total Tracks</th>

            </tr>

        </thead>

        <tbody>

            @foreach (var playlist in Model)
            {
                <tr>

                    <td>@playlist.Title</td>

                    <td>@playlist.CreatorName</td>

                    <td>@playlist.Videos.Count</td>

                </tr>
            }

        </tbody>

    </table>

</div>