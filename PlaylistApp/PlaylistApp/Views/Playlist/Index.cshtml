@model List<PlaylistApp.Models.Entities.Playlist>

<div style="background-color: #0f172a; min-height: 100vh; width: 100vw; position: relative; left: 50%; right: 50%; margin-left: -50vw; margin-right: -50vw; margin-top: -1.5rem; margin-bottom: -1.5rem;" class="py-5">
    <div class="container">
  
        <div class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom border-secondary border-opacity-25">
            <div>
                <h2 class="fw-bold text-white mb-0" style="letter-spacing: -0.5px;">My Playlists</h2>
                <p class="text-secondary small mb-0">Manage and view your collection</p>
            </div>

            <div class="d-flex align-items-center gap-3">
                <span class="text-secondary small">
                    Welcome, <strong class="text-white">@ViewBag.Username</strong>
                </span>

                <a asp-controller="Auth"
                   asp-action="Logout"
                   class="btn btn-outline-danger btn-sm px-3 fw-semibold"
                   style="border-radius: 8px;">
                    Logout
                </a>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <a asp-action="Create"
               class="btn text-white fw-semibold px-4 py-2"
               style="background-color: #6366f1; border-radius: 8px; transition: all 0.2s ease;">
                + Create Playlist
            </a>
        </div>

        <div class="card border-0 shadow-lg" style="background-color: #1e293b; border-radius: 16px; overflow: hidden;">
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0 align-middle" style="--bs-table-bg: transparent; --bs-table-hover-bg: rgba(255, 255, 255, 0.03);">
                    <thead>
                        <tr class="border-bottom border-secondary border-opacity-25 text-secondary text-uppercase small fw-semibold" style="letter-spacing: 0.5px;">
                            <th class="py-3 px-4">Title</th>
                            <th class="py-3 px-4">Creator</th>
                            <th class="py-3 px-4 text-end">Total Tracks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var playlist in Model)
                        {
                            <tr class="border-bottom border-secondary border-opacity-10">
                                <td class="py-3 px-4 fw-medium text-white">
                                    @playlist.Title
                                </td>
                                <td class="py-3 px-4 text-secondary">
                                    @playlist.CreatorName
                                </td>
                                <td class="py-3 px-4 text-end">
                                    <span class="badge bg-dark bg-opacity-50 border border-secondary border-opacity-25 px-3 py-2" style="border-radius: 12px; color: #818cf8;">
                                        @playlist.Videos.Count Tracks
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>