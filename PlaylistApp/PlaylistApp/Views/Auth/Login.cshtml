@model PlaylistApp.Models.DTOs.LoginDto

<div class="d-flex align-items-center justify-content-center min-vh-100 py-5"
     style="background: #0f172a; width: 100vw; position: relative; left: 50%; right: 50%; margin-left: -50vw; margin-right: -50vw; margin-top: -1.5rem;">

    <div class="card border-0 shadow-lg" style="width: 100%; max-width: 420px; background-color: #1e293b; border-radius: 16px;">
        <div class="card-body p-4 p-sm-5">

            <div class="text-center mb-4">
                <h3 class="fw-bold text-white mb-1" style="letter-spacing: -0.5px;">Welcome Back</h3>
                <p class="text-secondary small mb-0">Sign in to manage your playlist</p>
            </div>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 small py-2 px-3 mb-4" style="background-color: rgba(239, 68, 68, 0.1); color: #fca5a5;"></div>

            <form asp-action="Login" method="post">
                <div class="mb-3">
                    <label class="form-label text-secondary small fw-semibold">Username</label>
                    <input asp-for="Username" class="form-control border-0 py-2 px-3" style="background-color: #334155; color: #f8fafc; border-radius: 8px;" placeholder="Enter username" />
                    <span asp-validation-for="Username" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label text-secondary small fw-semibold">Password</label>
                    <input asp-for="Password" type="password" class="form-control border-0 py-2 px-3" style="background-color: #334155; color: #f8fafc; border-radius: 8px;" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="d-grid pt-2">
                    <button type="submit" class="btn text-white fw-semibold py-2" style="background-color: #6366f1; border-radius: 8px; transition: all 0.2s ease;">
                        Sign In
                    </button>
                </div>
            </form>

            <div class="text-center mt-4 pt-3 border-top border-secondary border-opacity-25">
                <span class="badge bg-dark bg-opacity-50 text-secondary fw-normal py-2 px-3" style="border-radius: 20px;">
                    <i class="bi bi-info-circle me-1"></i> Hint: <span class="text-light">admin</span> / <span class="text-light">password123</span>
                </span>
            </div>
        </div>
    </div>
</div>