<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PlaylistApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PlaylistApp.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>
<body style="background-color: #0f172a; color: #f8fafc; display: flex; flex-direction: column; min-height: 100vh; margin: 0;">

    <header class="w-100">
        <nav class="navbar navbar-expand-sm navbar-dark border-bottom border-secondary border-opacity-25 px-3" style="background-color: #1e293b;">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-white d-flex align-items-center gap-2" asp-area="" asp-controller="Playlist" asp-action="Index">
                    <i class="bi bi-music-note-list text-primary" style="color: #6366f1 !important;"></i> PlaylistApp
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 ms-3">
                        <li class="nav-item">
                            <a class="nav-link text-secondary fw-semibold px-3" asp-area="" asp-controller="Playlist" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-secondary fw-semibold px-3" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="flex-grow-1 w-100 d-flex flex-column" style="background-color: #0f172a;">
        <main role="main" class="flex-grow-1">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top border-secondary border-opacity-25 py-3 text-center text-secondary small w-100 mt-auto" style="background-color: #0f172a;">
        <div class="container">
            &copy; 2026 - PlaylistApp - <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-secondary text-decoration-underline">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>